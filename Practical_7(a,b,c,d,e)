Handle Missing Values
import numpy as np

# Impute numeric columns with median, categorical with mode
num_cols = df.select_dtypes(include=[np.number]).columns
cat_cols = df.select_dtypes(include=['object']).columns

for col in num_cols:
    if df[col].isnull().sum() > 0:
        df[col] = df[col].fillna(df[col].median())

for col in cat_cols:
    if df[col].isnull().sum() > 0:
        df[col] = df[col].fillna(df[col].mode()[0])

print("Total Missing Values After Handling:", df.isnull().sum().sum())

Remove Duplicate Records
# Remove duplicate rows from dataset
initial_rows = len(df)
df = df.drop_duplicates()
print(f"Removed {initial_rows - len(df)} duplicate row(s). New shape: {df.shape}")

Encode Categorical Data (Label Encoding / One-Hot Encoding)
from sklearn.preprocessing import LabelEncoder

# Encode categorical text columns into numbers
label_encoders = {}
for col in df.select_dtypes(include=['object']).columns:
    le = LabelEncoder()
    df[col] = le.fit_transform(df[col].astype(str))
    label_encoders[col] = le
    print(f"Encoded column '{col}' successfully.")

Rename Columns
# Clean and standardize column headers (lowercase and underscores)
